# Ground Control staging browser configuration.
# Copy these names into the staging hosting provider; do not commit real values.
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLIC_ANON_OR_PUBLISHABLE_KEY
STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
VITE_APP_ENVIRONMENT=staging
VITE_APP_RELEASE=ground-control-staging-YYYY.MM.DD.N
VITE_MONITORING_ENABLED=true
VITE_OPEN_METEO_PROXY_URL=https://YOUR_STAGING_SERVER_SIDE_WEATHER_PROXY

# Used only by the local/CI staging smoke script, not exposed to the browser.
STAGING_URL=https://YOUR_STAGING_DOMAIN
RELEASE_ENVIRONMENT=staging
RELEASE_ID=ground-control-staging-YYYY.MM.DD.N

# Server-side weather proxy. Staging may use the public provider through /api/weather.
# Set WEATHER_ALLOW_PUBLIC_API=true only for non-commercial staging or evaluation.
WEATHER_ALLOW_PUBLIC_API=true

# Server-only communications delivery configuration for staging.
# Email is protected by a mandatory redirect pilot on Vercel Preview/staging deployments.
COMMUNICATIONS_DEPLOYMENT_ENVIRONMENT=staging
COMMUNICATIONS_WEB_SEND_ENABLED=true
COMMUNICATIONS_PUBLIC_BASE_URL=https://YOUR_STAGING_DOMAIN
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVER_ONLY_SERVICE_ROLE_KEY

# Staging email pilot through Resend.
# Every provider email is redirected to one authorised internal adult test inbox.
COMMUNICATIONS_EMAIL_ENABLED=true
COMMUNICATIONS_EMAIL_PILOT_MODE=true
COMMUNICATIONS_EMAIL_PILOT_RECIPIENT=YOUR_INTERNAL_ADULT_TEST_EMAIL
COMMUNICATIONS_EMAIL_PILOT_OPERATOR_EMAILS=YOUR_AUTHORISED_GROUND_CONTROL_LOGIN_EMAIL
COMMUNICATIONS_EMAIL_PILOT_MAX_BATCH=5
COMMUNICATIONS_EMAIL_FROM=Ground Control Staging <matchday@YOUR_VERIFIED_DOMAIN>
RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=YOUR_SERVER_ONLY_RESEND_WEBHOOK_SECRET

# SMS and WhatsApp remain off during the email pilot.
COMMUNICATIONS_SMS_ENABLED=false
COMMUNICATIONS_WHATSAPP_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_CONTENT_SID=
