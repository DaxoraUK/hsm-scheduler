# Public browser configuration only. Never place Stripe secrets or the Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
VITE_APP_ENVIRONMENT=production
VITE_APP_RELEASE=ground-control-YYYY.MM.DD.N
VITE_MONITORING_ENABLED=true
VITE_OPEN_METEO_PROXY_URL=https://YOUR_SERVER_SIDE_WEATHER_PROXY

# Server-only commercial weather configuration used by /api/weather.
# Do not prefix these values with VITE_.
OPEN_METEO_API_KEY=YOUR_COMMERCIAL_OPEN_METEO_API_KEY
OPEN_METEO_API_BASE_URL=https://customer-api.open-meteo.com/v1/forecast

# Server-only communications delivery configuration.
# Nothing is sent unless the global flag and the individual channel flag are true.
COMMUNICATIONS_WEB_SEND_ENABLED=false
COMMUNICATIONS_PUBLIC_BASE_URL=https://YOUR_PRODUCTION_DOMAIN
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Email through Resend.
COMMUNICATIONS_EMAIL_ENABLED=false
COMMUNICATIONS_EMAIL_FROM=Ground Control <matchday@YOUR_DOMAIN>
RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=YOUR_SERVER_ONLY_RESEND_WEBHOOK_SECRET

# SMS through Twilio.
COMMUNICATIONS_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_SERVER_ONLY_TWILIO_AUTH_TOKEN
TWILIO_MESSAGING_SERVICE_SID=YOUR_TWILIO_MESSAGING_SERVICE_SID
# TWILIO_SMS_FROM=+441234567890

# WhatsApp through an approved Twilio Content Template containing {{1}}.
COMMUNICATIONS_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=+441234567890
TWILIO_WHATSAPP_CONTENT_SID=YOUR_APPROVED_CONTENT_SID
