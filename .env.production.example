# Public browser configuration only. Never place Stripe secrets or the Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
VITE_APP_ENVIRONMENT=production
VITE_APP_RELEASE=ground-control-YYYY.MM.DD.N
VITE_MONITORING_ENABLED=true
VITE_OPEN_METEO_PROXY_URL=https://YOUR_SERVER_SIDE_WEATHER_PROXY

# Server-only commercial weather configuration used by /api/weather.
# Do not prefix these values with VITE_.
OPEN_METEO_API_KEY=YOUR_COMMERCIAL_OPEN_METEO_API_KEY
OPEN_METEO_API_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
