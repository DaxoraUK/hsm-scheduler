{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/coach/invite",
      "destination": "/api/coach-invite"
    },
    {
      "source": "/api/communications/capabilities",
      "destination": "/api/communications-capabilities"
    },
    {
      "source": "/api/communications/dispatch",
      "destination": "/api/communications-dispatch"
    },
    {
      "source": "/api/communications/webhooks/resend",
      "destination": "/api/communications-webhooks-resend"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/automation/daily",
      "schedule": "15 7 * * *"
    }
  ]
}
