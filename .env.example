# Ground Control deployment configuration.
# These values are set once by the platform operator, not by individual clubs.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Required for commercial production weather after the live-weather proxy is deployed.
# VITE_OPEN_METEO_PROXY_URL=https://YOUR_SERVER_SIDE_WEATHER_PROXY

# Server-only web messaging is off by default.
COMMUNICATIONS_WEB_SEND_ENABLED=false
COMMUNICATIONS_EMAIL_ENABLED=false
COMMUNICATIONS_SMS_ENABLED=false
COMMUNICATIONS_WHATSAPP_ENABLED=false

# A Vercel Preview/staging deployment cannot enable email unless the redirect pilot is complete.
# COMMUNICATIONS_DEPLOYMENT_ENVIRONMENT=staging
# COMMUNICATIONS_EMAIL_PILOT_MODE=true
# COMMUNICATIONS_EMAIL_PILOT_RECIPIENT=authorised-adult-test@example.org
# COMMUNICATIONS_EMAIL_PILOT_OPERATOR_EMAILS=authorised-login@example.org
# COMMUNICATIONS_EMAIL_PILOT_MAX_BATCH=5

# Optional v3.8.2 automation and installed-app notifications.
# CRON_SECRET=generate-a-long-random-value
# DAXORA_AUTOMATION_SECRET=the-same-long-random-value
# VITE_DAXORA_VAPID_PUBLIC_KEY=url-safe-public-key
# DAXORA_VAPID_PUBLIC_KEY=url-safe-public-key
# DAXORA_VAPID_PRIVATE_KEY=server-only-url-safe-private-key
# DAXORA_VAPID_SUBJECT=mailto:support@example.org
